<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- geometry [m] (must match hyperdog_locomotion/config/locomotion.yaml) -->
  <xacro:property name="hip_x" value="0.175"/>
  <xacro:property name="hip_y" value="0.066"/>
  <xacro:property name="abad_length" value="0.104"/>
  <xacro:property name="upper_length" value="0.15"/>
  <xacro:property name="lower_length" value="0.14"/>
  <xacro:property name="foot_radius" value="0.02"/>

  <!-- joint position limits [rad] -->
  <xacro:property name="hip_lower" value="-1.0"/>
  <xacro:property name="hip_upper" value="1.0"/>
  <xacro:property name="uleg_lower" value="-1.2217"/>
  <xacro:property name="uleg_upper" value="3.14"/>
  <xacro:property name="lleg_lower" value="0.45"/>
  <xacro:property name="lleg_upper" value="2.3562"/>

  <!-- masses [kg] -->
  <xacro:property name="body_mass" value="3.0"/>
  <xacro:property name="hip_mass" value="0.3"/>
  <xacro:property name="uleg_mass" value="0.5"/>
  <xacro:property name="lleg_mass" value="0.2"/>
  <xacro:property name="foot_mass" value="0.1"/>

  <!-- foot friction (foot_mu) and IMU noise scale (imu_noise_scale) are xacro args of the top level file -->

  <!-- ===== BLDC actuator limits derived from the motor parameter file ===== -->
  <xacro:property name="bldc" value="${xacro.load_yaml(motors_file)['bldc_controller']['ros__parameters']}"/>

  <!-- writes <limit> for `joint` using its motor type -->
  <xacro:macro name="bldc_limit" params="joint lower upper">
    <xacro:property name="types" value="${bldc['joint_motor_types']}"/>
    <xacro:property name="mtype" value="${types[0] if len(types) == 1 else types[bldc['joints'].index(joint)]}"/>
    <xacro:property name="m" value="${bldc['motors'][mtype]}"/>
    <xacro:property name="kt" value="${m['torque_constant'] if m['torque_constant'] > 0 else 60.0 / (2.0 * pi * m['kv_rpm_per_volt'])}"/>
    <xacro:property name="peak" value="${kt * m['gear_ratio'] * m['gearbox_efficiency'] * m['max_current']}"/>
    <xacro:property name="vmax" value="${m['max_velocity'] if m['max_velocity'] > 0 else m['bus_voltage'] * m['voltage_utilization'] / kt / m['gear_ratio']}"/>
    <limit lower="${lower}" upper="${upper}" effort="${peak}" velocity="${vmax}"/>
  </xacro:macro>
</robot>
