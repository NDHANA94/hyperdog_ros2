<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    One leg: hip (ab/ad, axis +-x) -> uleg/thigh (axis -y) -> lleg/knee (axis +y) -> foot sphere.
    front: +1 front / -1 back, left: +1 left / -1 right
  -->
  <xacro:macro name="hyperdog_leg" params="prefix front left">
    <xacro:property name="side" value="${'LEFT' if left > 0 else 'RIGHT'}"/>

    <!-- hip -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <origin xyz="${front * hip_x} ${left * hip_y} 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <axis xyz="${left} 0 0"/>
      <xacro:bldc_limit joint="${prefix}_hip_joint" lower="${hip_lower}" upper="${hip_upper}"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <link name="${prefix}_hip_link">
      <visual>
        <geometry><mesh filename="file://$(find hyperdog_description)/meshes/${side}_HIP.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="hip_red"><color rgba="0.8 0.2 0.2 1"/></material>
      </visual>
      <inertial>
        <origin xyz="0.0 ${left * 0.02} 0.01" rpy="0 0 0"/>
        <mass value="${hip_mass}"/>
        <inertia ixx="0.000786" ixy="0" ixz="0" iyy="0.000281" iyz="0" izz="0.000714"/>
      </inertial>
    </link>

    <!-- thigh -->
    <joint name="${prefix}_uleg_joint" type="revolute">
      <origin xyz="0 ${left * abad_length} 0" rpy="0 0 0"/>
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_uleg_link"/>
      <axis xyz="0 -1 0"/>
      <xacro:bldc_limit joint="${prefix}_uleg_joint" lower="${uleg_lower}" upper="${uleg_upper}"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <link name="${prefix}_uleg_link">
      <visual>
        <geometry><mesh filename="file://$(find hyperdog_description)/meshes/${side}_ULEG.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="uleg_orange"><color rgba="0.95 0.55 0.1 1"/></material>
      </visual>
      <collision name="${prefix}_uleg_collision">
        <origin xyz="${-upper_length / 2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${upper_length} 0.03 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.02 ${-left * 0.02} 0.0" rpy="0 0 0"/>
        <mass value="${uleg_mass}"/>
        <inertia ixx="0.000532" ixy="0" ixz="0" iyy="0.001786" iyz="0" izz="0.002125"/>
      </inertial>
    </link>

    <!-- shank -->
    <joint name="${prefix}_lleg_joint" type="revolute">
      <origin xyz="${-upper_length} 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_uleg_link"/>
      <child link="${prefix}_lleg_link"/>
      <axis xyz="0 1 0"/>
      <xacro:bldc_limit joint="${prefix}_lleg_joint" lower="${lleg_lower}" upper="${lleg_upper}"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <link name="${prefix}_lleg_link">
      <visual>
        <geometry><mesh filename="file://$(find hyperdog_description)/meshes/LLEG.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="lleg_yellow"><color rgba="0.75 0.7 0.2 1"/></material>
      </visual>
      <collision name="${prefix}_lleg_collision">
        <origin xyz="${lower_length / 2 - 0.01} 0 0" rpy="0 0 0"/>
        <geometry><box size="${lower_length - 0.04} 0.02 0.02"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <mass value="${lleg_mass}"/>
        <inertia ixx="0.0000632" ixy="0" ixz="0" iyy="0.000655" iyz="0" izz="0.000623"/>
      </inertial>
    </link>

    <!-- foot -->
    <joint name="${prefix}_foot_fixed" type="fixed">
      <origin xyz="${lower_length} 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_lleg_link"/>
      <child link="${prefix}_foot"/>
    </joint>
    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="${foot_radius}"/></geometry>
        <material name="foot_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${foot_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${foot_mass}"/>
        <inertia ixx="0.000016" ixy="0" ixz="0" iyy="0.000016" iyz="0" izz="0.000016"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_foot_fixed">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${prefix}_foot">
      <mu1>${foot_mu}</mu1>
      <mu2>${foot_mu}</mu2>
      <kp>100000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.0005</minDepth>
    </gazebo>
  </xacro:macro>
</robot>
