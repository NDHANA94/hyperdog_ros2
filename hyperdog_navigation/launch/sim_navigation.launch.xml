<?xml version="1.0"?>
<!--
  HyperDog in Gazebo (obstacle world, lidar) with Nav2.

  ros2 launch hyperdog_navigation sim_navigation.launch.xml [headless:=false] [rviz:=false]
  then send a goal in the odom frame, e.g.
  ros2 action send_goal /navigate_to_pose nav2_msgs/action/NavigateToPose \
    "{pose: {header: {frame_id: odom}, pose: {position: {x: 5.0}, orientation: {w: 1.0}}}}"
  or run the automated check (see the package README): navigate_test with use_sim_time true
-->
<launch>
  <arg name="world" default="obstacles"/>
  <arg name="headless" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="perception" default="false"/>

  <include file="$(find-pkg-share hyperdog_gazebo)/launch/sim.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="use_lidar" value="true"/>
    <arg name="use_camera" value="$(var perception)"/>
    <arg name="perception" value="$(var perception)"/>
    <arg name="foot_rolling" value="true"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>
  <include file="$(find-pkg-share hyperdog_navigation)/launch/navigation.launch.xml">
    <arg name="use_sim_time" value="true"/>
  </include>
</launch>
