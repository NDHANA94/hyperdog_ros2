<?xml version="1.0"?>
<!--
  Automated closed-loop validation in simulation (headless):
  stand up, standing push recovery, trot forward / sideways / turning, push while trotting,
  gait switching, stop. Writes a report and exits with the result.

  ros2 launch hyperdog_gazebo validate.launch.xml [world:=flat] [report:=/tmp/hyperdog_validation.md]
-->
<launch>
  <arg name="world" default="flat"/>
  <arg name="headless" default="true"/>
  <arg name="report" default="hyperdog_validation_report.md"/>
  <arg name="locomotion_params" default="$(find-pkg-share hyperdog_locomotion)/config/locomotion.yaml"/>
  <arg name="scenario" default="full" description="full | push | walk"/>

  <include file="$(find-pkg-share hyperdog_gazebo)/launch/sim.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="use_lidar" value="false"/>
    <arg name="use_camera" value="false"/>
    <arg name="locomotion_params" value="$(var locomotion_params)"/>
  </include>

  <node pkg="hyperdog_gazebo" exec="scenario_runner" name="scenario_runner" output="screen" on_exit="shutdown">
    <param name="use_sim_time" value="true"/>
    <param name="report_file" value="$(var report)"/>
    <param name="scenario" value="$(var scenario)"/>
  </node>
</launch>
