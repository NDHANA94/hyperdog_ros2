<?xml version="1.0"?>
<!-- HyperDog Gazebo Harmonic world (stairs: 5 steps up (4 cm rise, 35 cm run) from x = 1.5 m, 1 m landing, 5 steps down). All worlds are named "hyperdog" so that
     the push (wrench) topics are /world/hyperdog/wrench[/persistent|/clear]. -->
<sdf version="1.10">
  <world name="hyperdog">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.5 0.55 0.5 1</ambient><diffuse>0.5 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="step_up_0">
      <static>true</static>
      <pose>1.675 0.000 0.0200 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.0400</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.0400</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_up_1">
      <static>true</static>
      <pose>2.025 0.000 0.0400 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.0800</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.0800</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_up_2">
      <static>true</static>
      <pose>2.375 0.000 0.0600 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.1200</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.1200</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_up_3">
      <static>true</static>
      <pose>2.725 0.000 0.0800 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.1600</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.1600</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_up_4">
      <static>true</static>
      <pose>3.075 0.000 0.1000 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.2000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.2000</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="landing">
      <static>true</static>
      <pose>3.750 0.000 0.1000 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.000 2.000 0.2000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.000 2.000 0.2000</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_down_0">
      <static>true</static>
      <pose>4.425 0.000 0.0800 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.1600</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.1600</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_down_1">
      <static>true</static>
      <pose>4.775 0.000 0.0600 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.1200</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.1200</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_down_2">
      <static>true</static>
      <pose>5.125 0.000 0.0400 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.0800</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.0800</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_down_3">
      <static>true</static>
      <pose>5.475 0.000 0.0200 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.350 2.000 0.0400</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.350 2.000 0.0400</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
