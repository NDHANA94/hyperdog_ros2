<?xml version="1.0"?>
<!-- HyperDog Gazebo Harmonic world (ramps and small steps). All worlds are named "hyperdog" so that
     the push (wrench) topics are /world/hyperdog/wrench[/persistent|/clear]. -->
<sdf version="1.10">
  <world name="hyperdog">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.5 0.55 0.5 1</ambient><diffuse>0.5 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ramp_up">
      <static>true</static>
      <pose>2.990 0 0.090 0 -0.1396 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.000 2 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>2.000 2 0.1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="plateau">
      <static>true</static>
      <pose>4.731 0 0.139 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 2 0.278</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.5 2 0.278</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_down">
      <static>true</static>
      <pose>6.471 0 0.090 0 0.1396 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.000 2 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>2.000 2 0.1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_0">
      <static>true</static>
      <pose>1.50 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_1">
      <static>true</static>
      <pose>2.00 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_2">
      <static>true</static>
      <pose>2.50 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_3">
      <static>true</static>
      <pose>3.00 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_4">
      <static>true</static>
      <pose>3.50 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="slab_5">
      <static>true</static>
      <pose>4.00 2.5 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.025</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
